          Welbl, Johannes and Gowal, Sven and Cherepanov, Alexey and
          Molloy, James and Mankowitz, Daniel and Sutherland, Rob and
          Kohli, Pushmeet and Kavukcuoglu, Koray and Hassabis, Demis and
          Silver, David},
  journal={Science},
  volume={378},
  number={6624},
  pages={1092--1097},
  year={2022}
